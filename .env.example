# Local development only. Copy to .env (git ignores it). Compose's postgres listens on 5433.
CODE_SECRET_KEY=insecure-local-development-key-never-use-this-anywhere-else-000000
CODE_DATABASE_URL=postgresql://code:code@localhost:5433/code
CODE_DEBUG=true
CODE_ALLOWED_HOSTS=localhost,127.0.0.1

# Where collectstatic writes (git ignores it).
CODE_STATIC_ROOT=staticfiles

# Compose's Redis listens on 6380.
CODE_REDIS_URL=redis://localhost:6380/0

# The content folder manage.py rebuild_index reads; or pass --root. Never used by tests.
# CODE_CONTENT_ROOT=../comeni-code-content

# Accounts (M4.3). Where invite links and sign-in redirects point: the web app (npm run dev).
CODE_WEB_ORIGIN=http://127.0.0.1:5173
# Secure cookies need HTTPS: true on a hosted stack, false here.
CODE_SECURE_COOKIES=false
# GitHub sign-in is off unless both are set (a GitHub OAuth app's client id and secret).
# CODE_GITHUB_CLIENT_ID=
# CODE_GITHUB_CLIENT_SECRET=
# Mail goes to the console unless an SMTP host is set.
# CODE_SMTP_HOST=
# CODE_SMTP_PORT=587
# CODE_SMTP_USER=
# CODE_SMTP_PASSWORD=
# CODE_EMAIL_FROM=Comeni Code <noreply@localhost>
