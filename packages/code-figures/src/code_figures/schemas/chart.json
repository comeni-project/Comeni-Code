{
  "$comment": "Vega-Lite, an allowlisted subset (M6.4 spec, M6FG.4). Every object is closed; anything not here is refused by its path. Widen only: a narrowing is a new component.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mark": {
      "$ref": "#/$defs/mark"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/cell"
            }
          }
        }
      },
      "required": [
        "values"
      ]
    },
    "encoding": {
      "$ref": "#/$defs/encoding"
    },
    "layer": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mark": {
            "$ref": "#/$defs/mark"
          },
          "encoding": {
            "$ref": "#/$defs/encoding"
          }
        },
        "required": [
          "mark"
        ]
      }
    }
  },
  "required": [
    "data"
  ],
  "$defs": {
    "cell": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "markType": {
      "enum": [
        "bar",
        "line",
        "point",
        "area",
        "rule",
        "tick",
        "text"
      ]
    },
    "mark": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "point",
            "area",
            "rule",
            "tick",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "$ref": "#/$defs/markType"
            },
            "point": {
              "type": "boolean"
            },
            "interpolate": {
              "enum": [
                "linear",
                "monotone",
                "step"
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/channel"
        },
        "y": {
          "$ref": "#/$defs/channel"
        },
        "x2": {
          "$ref": "#/$defs/channel"
        },
        "y2": {
          "$ref": "#/$defs/channel"
        },
        "xOffset": {
          "$ref": "#/$defs/channel"
        },
        "color": {
          "$ref": "#/$defs/channel"
        },
        "size": {
          "$ref": "#/$defs/channel"
        },
        "shape": {
          "$ref": "#/$defs/channel"
        },
        "opacity": {
          "$ref": "#/$defs/channel"
        },
        "text": {
          "$ref": "#/$defs/channel"
        },
        "detail": {
          "$ref": "#/$defs/channel"
        },
        "row": {
          "$ref": "#/$defs/channel"
        },
        "column": {
          "$ref": "#/$defs/channel"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_ -]*$",
          "maxLength": 40
        },
        "type": {
          "enum": [
            "quantitative",
            "ordinal",
            "nominal",
            "temporal"
          ]
        },
        "aggregate": {
          "enum": [
            "count",
            "sum",
            "mean",
            "median",
            "min",
            "max"
          ]
        },
        "bin": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxbins": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 50
                }
              }
            }
          ]
        },
        "timeUnit": {
          "enum": [
            "year",
            "month",
            "date",
            "day",
            "hours",
            "yearmonth",
            "yearmonthdate",
            "monthdate"
          ]
        },
        "sort": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ascending",
                "descending"
              ]
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 50,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          ]
        },
        "stack": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "zero",
                "normalize",
                "center"
              ]
            },
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zero": {
              "type": "boolean"
            },
            "domain": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "type": {
              "enum": [
                "linear",
                "log",
                "sqrt"
              ]
            }
          }
        },
        "axis": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 80
                },
                "format": {
                  "type": "string",
                  "pattern": "^[0-9.,%$~+ (sdefgrx-]*$",
                  "maxLength": 20
                },
                "tickCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "legend": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    }
  }
}
