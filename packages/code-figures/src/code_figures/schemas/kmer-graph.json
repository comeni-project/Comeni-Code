{
  "$comment": "Reads joined by their k-mers (M6.6a spec, M6DC.1). The author writes the reads, k and the highlight; the k-mers, edges, branches, a path and what it spells are computed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": { "type": "string", "pattern": "^[A-Za-z]+$", "maxLength": 20, "format": "dna" },
          "note": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "required": ["sequence"]
      }
    },
    "k": { "type": "integer", "minimum": 2, "maximum": 8 },
    "highlight": { "enum": ["none", "branches", "path"] },
    "path": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "spell": { "enum": ["shown", "hidden"] }
  },
  "required": ["reads", "k", "highlight"]
}
