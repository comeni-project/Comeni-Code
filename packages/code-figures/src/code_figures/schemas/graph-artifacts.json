{
  "$comment": "Tips and bubbles found from the reads (M6.6a spec, M6DC.1): a run of k-mers held by one read rejoining the path is a bubble, else a tip. Computed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^[A-Za-z]+$",
            "maxLength": 20,
            "format": "dna"
          }
        },
        "required": [
          "sequence"
        ]
      }
    },
    "k": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    }
  },
  "required": [
    "reads",
    "k"
  ]
}
